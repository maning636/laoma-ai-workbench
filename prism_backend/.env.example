# ===============================
# 老马AI工作台 FastAPI 后端环境变量模板
# ===============================
# 字段名与 fastapi_app/core/config.py 的 Settings 字段一一对应（case_sensitive=True）。
# 本文件只是"模板"，不含任何真实密钥；仅列出 config.py 实际读取的字段与必要的浏览器
# / Playwright 环境变量（后者由 utils 与 automation 层直接读 os.getenv，不通过 Settings）。
# 若字段已在 config.py 有默认值，这里保留注释即可，无需强制覆盖。
# ===============================

# ===============================
# 浏览器配置（Playwright / Chrome / Firefox）
# 这些字段不通过 Settings 读取，由 utils/runtime_env、utils/base_social_media、
# utils/automation_bootstrap 直接读 os.getenv；保留是因为启动脚本与本地开发依赖。
# ===============================
# 是否启用无头模式（服务器/Docker 必须为 true）
PLAYWRIGHT_HEADLESS=true
# Chrome / Chromium 路径（可选，未设置时会自动探测 fallback）
# LOCAL_CHROME_PATH=browsers/chromium/chromium-1161/chrome-win/chrome.exe
# LOCAL_CHROME_PATH_MAC=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# LOCAL_CHROME_PATH_WIN=C:/Program Files/Google/Chrome/Application/chrome.exe
# LOCAL_CHROME_PATH_LINUX=/usr/bin/chromium-browser
# LOCAL_CHROME_HEADLESS_SHELL_PATH=browsers/chromium/chromium_headless_shell-1161/chrome-win/chrome-headless-shell.exe
# LOCAL_FIREFOX_PATH=browsers/firefox/firefox-1495/firefox/firefox.exe
# Playwright 浏览器存储目录（可选，默认由 playwright install 决定）
# PLAYWRIGHT_BROWSERS_PATH=browsers

# ===============================
# 服务器配置（config.py: HOST / PORT / DEBUG）
# config.py 使用 case_sensitive=True，只读 HOST / PORT。BACKEND_* 前缀名不属后端 Settings
# （属于 supervisor / 启动脚本层的映射），如需调整请在根 env.example 或启动脚本中处理。
# ===============================
PORT=7000
HOST=0.0.0.0
DEBUG=false
# API_V1_PREFIX=/api/v1

# ===============================
# 时区与基础信息（config.py 默认值即生效，一般无需修改）
# ===============================
# PROJECT_NAME=Prism
# VERSION=2.0.0
# DESCRIPTION=矩阵平台自动化发布系统
# API_V1_PREFIX=/api/v1
# TIMEZONE=Asia/Shanghai
# USE_BEIJING_TIME=true

# ===============================
# 数据目录（config.py: DATA_DIR）
# 权威入口是 paths.get_data_dir()，Settings.DATA_DIR 会被 field_validator 强制改写。
# 用户显式覆盖只能通过 env LAOMA_DATA_DIR（在 paths.py 内读取，不经 Settings 校验）。
# ===============================
# DATA_DIR=<默认由 paths.get_data_dir() 决定>
# LAOMA_DATA_DIR=/path/to/data        # 可选：显式指定数据根目录

# ===============================
# 数据库路径（config.py: 由 DATA_DIR 派生；一般不手动设置）
# ===============================
# DATABASE_PATH=<DATA_DIR>/db/database.db
# COOKIE_DB_PATH=<DATA_DIR>/db/cookie_store.db
# AI_LOGS_DB_PATH=<DATA_DIR>/db/ai_logs.db
# DATABASE_URL=                        # 留空 = 使用 SQLite；填写 mysql+pymysql://... 启用 MySQL
# DB_PATH_REL=db/database.db           # myUtils/video_collector.py 读取的相对路径（非 Settings）

# ===============================
# Redis / Celery（config.py: REDIS_URL / CELERY_BROKER_URL / CELERY_RESULT_BACKEND）
# ===============================
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=                   # 空则回落到 REDIS_URL
# CELERY_RESULT_BACKEND=               # 空则回落到 REDIS_URL

# ===============================
# 文件存储目录（config.py: 均从 DATA_DIR 派生，一般不手动设置）
# ===============================
# UPLOAD_DIR=<DATA_DIR>/uploads
# COOKIE_FILES_DIR=<DATA_DIR>/cookiesFile
# FINGERPRINTS_DIR=<DATA_DIR>/fingerprints
# BROWSER_PROFILES_DIR=<DATA_DIR>/browser_profiles
# VIDEO_FILES_DIR=<DATA_DIR>/videoFile

# ===============================
# Persona Studio（config.py: PERSONA_*，默认关）
# ===============================
# PERSONA_ENABLED=false
# PERSONA_API_URL=http://127.0.0.1:8787
# PERSONA_REQUEST_TIMEOUT=15.0
# PERSONA_DEFAULT_ENGINE=patchright
# PERSONA_INJECT_PROXY=true
# PERSONA_LAUNCH_TIMEOUT=60

# ===============================
# Laoma 运行时（config.py: LAOMA_*）
# ===============================
# LAOMA_BROWSER_BACKEND_DEFAULT=patchright   # 每个账号的默认浏览器后端
# LAOMA_DOUYIN_LOGIN_MODE=browser            # browser | http
# LAOMA_RUNTIME_LOCK_ENABLED=true            # Account Runtime 分布式锁（Redis per-account）
# LAOMA_RUNTIME_LOCK_TTL=300                 # 锁 TTL（秒），长任务靠 heartbeat 续期

# ===============================
# 任务队列（config.py: TASK_*）
# ===============================
# TASK_QUEUE_MAX_WORKERS=3
# TASK_MAX_RETRIES=3

# ===============================
# 日志（config.py: LOG_LEVEL / LOG_FILE）
# LOG_FILE 是完整文件路径；原 LOG_DIR 已废弃，由 paths.get_data_dir()/logs 派生。
# ===============================
LOG_LEVEL=INFO
# LOG_FILE=<DATA_DIR>/logs/fastapi_app.log

# ===============================
# AI 服务配置
# SiliconFlow / DeepSeek OCR（config.py: SILICONFLOW_* / DEEPSEEK_OCR_MODEL）
# 真实 key 放在被 gitignore 的 .env 里，此处仅保留占位符。
# ===============================
# SILICONFLOW_API_KEY=your_siliconflow_api_key_here
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_PROMPT_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# SILICONFLOW_IMAGE_MODEL=Qwen/Qwen-Image-Edit-2509
# DEEPSEEK_OCR_MODEL=deepseek-ai/DeepSeek-OCR

# Legacy AI fallback（config.py: AI_API_KEY / AI_BASE_URL / AI_MODEL）
# 当 ai_model_configs 未配置时才会走这一组；一般与 SiliconFlow 二选一。
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

# ===============================
# Douyin / TikTok API 集成（config.py: DOUYIN_TIKTOK_API_*）
# ===============================
# DOUYIN_TIKTOK_API_ENABLED=true
# DOUYIN_TIKTOK_API_PREFIX=/api/v1/douyin-tiktok

# ===============================
# 安全（config.py: SECRET_KEY / ACCESS_TOKEN_EXPIRE_MINUTES）
# JWT 直接复用 SECRET_KEY；如需独立 JWT key，需在 config.py 增加字段并改签发/校验逻辑。
# ===============================
# SECRET_KEY=your-secret-key-change-in-production
# ACCESS_TOKEN_EXPIRE_MINUTES=1440          # 默认 24 小时

# ===============================
# CORS（config.py: CORS_ORIGINS，List[str]）
# pydantic-settings 对 List[str] 用 JSON 解析，必须写成 JSON 数组字符串（不是逗号分隔）。
# 默认已含 http://localhost:3000、http://127.0.0.1:3000、http://localhost:5173。
# ===============================
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
