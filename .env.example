# ===============================
# Prism-Fusion · Community Edition 环境变量模板
# ===============================
#
# 本文件是 GitHub 开源的 Community Edition 精简配置,只需**本地运行所需**的
# 最小集合。完整字段说明见:
#   - prism_backend/.env.example    (后端完整字段)
#   - cloud_service/.env.example    (云端服务完整字段)
#
# 使用步骤:
#   1. 复制本文件为 .env  (cp .env.example .env 或 Copy-Item)
#   2. 填入下方标注 "必填" 的字段(至少 REDIS_URL)
#   3. 跑 `start.bat` 或 `./start-pm2.sh` 启动
#
# Community vs Pro 差异:
#   - Community: 3 账号 / 3 平台 / 自配 LLM key / 无数据回收 / 无指纹增强
#   - Pro     : 无限账号 / 8 平台 / 云端 AI / 数据回收 / Persona 指纹 / 代理 IP 池
#   - 升级方式: 在客户端点"升级 Pro",或通过 cloud_service/.env.example
#     配 CLOUD_URL 指向官方云。
#
# 全部字段默认值已生效,可跳过非必填项直接启动。
# ===============================


# ===============================
# [必填] 后端服务 (prism_backend)
# ===============================
# 本地 FastAPI 端口
PORT=7000
HOST=0.0.0.0
DEBUG=false

# 时区(影响定时发布)
TIMEZONE=Asia/Shanghai
USE_BEIJING_TIME=true

# Redis 地址(调度 / Celery broker)
REDIS_URL=redis://localhost:6379/0

# 数据根目录(默认由 paths.py 决定;一般无需修改)
# LAOMA_DATA_DIR=./runtime-data


# ===============================
# [可选] 浏览器运行时
# ===============================
# 是否启用无头模式(服务器/Docker 必须为 true;本地桌面调试可 false)
PLAYWRIGHT_HEADLESS=true

# Chrome / Chromium 路径(可选,未设置时自动探测本机 Chrome)
# LOCAL_CHROME_PATH_WIN=C:/Program Files/Google/Chrome/Application/chrome.exe
# LOCAL_CHROME_PATH_MAC=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# LOCAL_CHROME_PATH_LINUX=/usr/bin/chromium-browser

# 浏览器后端:Community 默认 patchright 直连;Pro 支持 persona
# patchright : 基础浏览器自动化(所有账号都能跑)
# persona    : 反检测指纹增强(Pro 特性,Community 客户端会自动禁用)
LAOMA_BROWSER_BACKEND_DEFAULT=patchright

# 抖音登录模式(默认 browser,即 patchright 扫码)
LAOMA_DOUYIN_LOGIN_MODE=browser


# ===============================
# [可选] Open Core 功能限制 (Community 默认值)
# ===============================
# 这些值由 cloud_service/billing/feature_gate.py 的 COMMUNITY_FLAGS 提供;
# 本地自部署的 cloud_service 可通过 CLOUD_* 环境变量覆盖,一般无需修改。
#
# Community 默认(3 账号 / 3 平台):
#   CLOUD_MAX_ACCOUNTS=3
#   CLOUD_MAX_PLATFORMS=3
#
# Pro 默认(无限账号 / 8 平台):
#   CLOUD_MAX_ACCOUNTS=-1
#   CLOUD_MAX_PLATFORMS=8
#
# 若要绕过 feature gate 做本地调试(仅供开发者,不建议生产):
#   CLOUD_FEATURE_GATE_DISABLED=true
# ===============================


# ===============================
# [可选] AI 内容生成 (Community = 自配 key)
# ===============================
# Community 版走"离线模式":用户自配 LLM key,通过本地 .env 加载;
# Pro 版走云端代理(cloud_service),无需在本地配置 key。
#
# 客户端 AI 对话 (prism_backend/fusion_ai/):
#   DEEPSEEK_API_KEY=            # 或走其他 provider
#   OPENAI_API_KEY=
#   OPENAI_BASE_URL=            # 自定义 base_url(如 DeepSeek / OpenRouter)
#   OPENAI_MODEL=gpt-4o-mini    # 默认模型
#
# 详细配置见 prism_backend/config/llm_config.toml
# (Hermes Agent 的 provider / model / api_key / base_url)
# ===============================


# ===============================
# [可选] 云端服务连接 (仅当使用官方 cloud_service 时)
# ===============================
# Community 用户注册后可对接官方云端,获取:
#   - 云端 AI prompt(防逆向)
#   - 数据回收能力(TikTok / YouTube / B 站)
#   - Persona 指纹增强
#   - 代理 IP 池
#   - Hermes Agent 云端代理(2 个配额)
#
# 官方云端 URL(生产环境由运营方提供):
# CLOUD_URL=https://cloud.prism-fusion.example.com
#
# 客户端注册/登录后获取的 JWT(通过 Web 控制台管理,无需手动填):
# CLOUD_ACCESS_TOKEN=


# ===============================
# [仅开发者] 本地自建 cloud_service
# ===============================
# 若要自部署一个本地 cloud_service (见 cloud_service/.env.example):
#   CLOUD_DB_URL=sqlite:///cloud_service/cloud.db
#   CLOUDJWT_SECRET=<your-secret>
#   CLOUD_LLM_API_KEY=sk-xxx
#   CLOUD_LLM_BASE_URL=https://api.openai.com/v1
#
# 详见 cloud_service/.env.example 完整字段。
# ===============================
