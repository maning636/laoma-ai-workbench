# ===============================
# Prism-Fusion Cloud Service 环境变量模板
# ===============================
# 字段名与 cloud_service/settings.py 及 cloud_service/**/*.py 里 os.getenv /
# _get_str / _get_int 的读取点一一对应。本文件只是模板,不含任何真实密钥;
# 真实值请放被 gitignore 的 cloud_service/.env。默认值在代码里已生效,一般无需覆盖。
# ===============================

# ===============================
# 服务基本信息
# ===============================
# CLOUD_APP_NAME: FastAPI title;仅用于 /openapi.json 的展示名
CLOUD_APP_NAME=Prism-Fusion Cloud
# CLOUD_DEBUG: 打开后启动脚本可使用 --reload(生产必须 false)
CLOUD_DEBUG=false

# ===============================
# 数据库
# ===============================
# 数据库 URL。默认 sqlite:///cloud_service/cloud.db(单文件本地库)。
# 生产建议 mysql+pymysql://user:pass@host:3306/cloud
# 兼容回退:CLOUD_DB_URL 未设置时读 DB_URL(便于和后端共享同一 env)
# CLOUD_DB_URL=sqlite:///cloud_service/cloud.db
# DB_URL=

# ===============================
# JWT / 安全
# ===============================
# JWT 密钥。**生产必须显式配置**;未配置时进程内随机生成,重启后所有
# access/refresh token 全失效(设计如此,避免硬编码默认密钥泄漏)。
# 优先级:CLOUDJWT_SECRET > JWT_SECRET > CLOUD_SECRET_KEY > SECRET_KEY
CLOUDJWT_SECRET=
# Legacy JWT secret fallbacks(仅本地开发便利,生产必须显式配置 CLOUDJWT_SECRET)
# JWT_SECRET=
# CLOUD_SECRET_KEY=
# SECRET_KEY=
# CLOUDJWT_ALGORITHM: JWT 签名算法,默认 HS256
CLOUDJWT_ALGORITHM=HS256
# CLOUD_ACCESS_TOKEN_EXPIRE_MINUTES: access token 过期(分钟),默认 30
CLOUD_ACCESS_TOKEN_EXPIRE_MINUTES=30
# CLOUD_REFRESH_TOKEN_EXPIRE_DAYS: refresh token 过期(天),默认 7
CLOUD_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===============================
# CORS(浏览器直连)
# ===============================
# 逗号分隔的允许来源列表。默认覆盖本地前端开发(3000 端口);
# 生产应替换为真实前端域名。注意:不要把默认值写成 "*" 同时开
# allow_credentials,这是安全反模式;cloud_service 明确
# allow_credentials=False(前端 client-gateway 使用 credentials:"omit")。
CLOUD_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ===============================
# 计费额度
# ===============================
# free 用户月度 LLM 调用额度(次);0 = 明确禁用,-1 = 无限
CLOUD_FREE_QUOTA=20
# pro 用户月度额度;-1 表示无限(默认)
CLOUD_PRO_QUOTA=-1

# ===============================
# 订单超时清理调度(P4)
# ===============================
# 只影响 status='created' 的订单;不影响 paid / refunded / closed。
# 多 worker 部署下每个 worker 都会跑一份,代码里已按 id 列表做幂等关闭。
CLOUD_ORDER_TIMEOUT_ENABLED=true
CLOUD_ORDER_TIMEOUT_INTERVAL_SECONDS=3600
CLOUD_ORDER_TIMEOUT_HOURS=24

# ===============================
# 日终对账调度(P6)
# ===============================
# **默认关闭**:reconcile_task(platform_bills=None) 会遍历已注册 adapter 调
# adapter.fetch_bill();一旦接入真实商户 adapter 就是外部调用,不能在生产
# 里悄悄默认跑。接入真实 adapter 后请显式开启并核对 fetch_bill 的限流/重试。
CLOUD_RECONCILE_ENABLED=false
CLOUD_RECONCILE_INTERVAL_SECONDS=86400
CLOUD_RECONCILE_LOOKBACK_HOURS=24

# ===============================
# LLM 代理(C14,OpenAI 兼容)
# ===============================
# 上游 LLM API key。留空时 /cloud/llm/chat 会返回 500,请部署前显式配置。
CLOUD_LLM_API_KEY=
# 上游 base_url。默认指向官方 OpenAI 兼容端点。
# CLOUD_LLM_BASE_URL=https://api.openai.com/v1
# CLOUD_LLM_MODEL=gpt-4o-mini

# ===============================
# 支付(C19)
# ===============================
# 管理员退款/手工干预端点的门禁 token。生产必须显式配置一个高熵字符串;
# 未配置时相应端点返回 401。
CLOUD_ADMIN_TOKEN=
# HMAC 签名密钥(用于 /cloud/llm/verify_signature 之类的可选校验端点)。
# 未配置时该端点走默认行为。
CLOUD_HMAC_SECRET=

# 价目表(JSON)。默认:{"pro_30": 99.00, "pro_365": 799.00, "free": 0.00};
# 其他 days 按 pro_30 折日价 3.3 元/天。留空使用默认表。
# CLOUD_PAYMENT_PRICES={"pro_30":99.0,"pro_365":799.0,"free":0.0}
# 支付回调 URL(生产应使用真实域名)。留空回落到 /cloud/payment/callback/{channel}
# CLOUD_PAYMENT_NOTIFY_URL=/cloud/payment/callback/alipay
# 支付成功回跳 URL。留空回落到 /payment/success
CLOUD_PAYMENT_RETURN_URL=/payment/success

# ── 支付宝 ─────────────────────────────────────
# 沙箱模式默认开(1)。接入生产前请切换为 0 并替换真实凭据。
CLOUD_ALIPAY_SANDBOX=1
CLOUD_ALIPAY_APP_ID=
# 商户公钥(生产)—— 建议放 .env 而非版本库
# CLOUD_ALIPAY_APP_PUBLIC_KEY=
# 商户私钥(仅沙箱/mock 使用,字段名与官方不同,是本项目兼容别名)
# CLOUD_ALIPAY_SECRET=

# ── 微信支付 V3 ─────────────────────────────────
CLOUD_WECHAT_SANDBOX=1
CLOUD_WECHAT_APP_ID=
CLOUD_WECHAT_MCHID=
# 平台 APIv3 密钥(32 字节)—— 建议放 .env
# CLOUD_WECHAT_API_V3_KEY=
# 商户 API 密钥(APIv2 legacy 字段,当前 adapter 若使用请填)
# CLOUD_WECHAT_API_SECRET=
