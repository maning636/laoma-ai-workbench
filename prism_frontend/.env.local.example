# 后端服务器地址 (FastAPI)
NEXT_PUBLIC_BACKEND_URL=http://localhost:7000
NEXT_PUBLIC_API_URL=http://localhost:7000

# AI 功能已集成到后端，无需配置 OpenAI API Key
# 后端使用硅基流动 API (已配置)

# 云端 SaaS 后端根地址(不带 /cloud 后缀,gateway 会自动补)
# NEXT_PUBLIC_CLOUD_URL=https://api.prism.local

# 客户端订阅心跳间隔(浏览器侧 verifyLicense 的调度周期)。
# 支持毫秒数字字符串(如 "3600000")或单位后缀(如 "30m"、"2h"、"1d")。
# 缺省时使用 24h 默认值。
# NEXT_PUBLIC_LICENSE_HEARTBEAT_MS=24h
